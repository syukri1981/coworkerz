  skos:notation "strat:international-expansion" ;
  aether:domain "corporate_strategy" ;
  skos:prefLabel "International Market & Enterprise ARR Strategy"@en ;
  skos:altLabel "market expansion"@en, "pipeline"@en, "bookings"@en, "board strategy"@en, "annual plan"@en, "enterprise gtm"@en, "market share"@en ;
