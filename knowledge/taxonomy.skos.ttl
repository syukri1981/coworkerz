  skos:related <urn:aether:skos:fin:capital-allocation>, <urn:aether:skos:tech:security-zero-trust> ;
  skos:definition "Board-restricted corporate development, acquisition target diligence, deal structuring, and 90-day PMI playbooks."@en .

<urn:aether:skos:strat:agentic-pricing> a skos:Concept ;
  skos:inScheme <urn:aether:enterprise:taxonomy> ;
  skos:notation "strat:agentic-pricing" ;
  aether:domain "corporate_strategy" ;
  skos:prefLabel "Autonomous Agent Packaging & Outcome Pricing"@en ;
  skos:altLabel "pricing"@en, "outcome-based"@en, "seat-based"@en, "execution credits"@en, "packaging"@en, "monetization"@en, "cannibalization"@en ;
